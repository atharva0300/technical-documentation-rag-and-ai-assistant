# Database
DATABASE_URL=postgresql+psycopg2://raguser:ragpassword@localhost:5444/ragdb

# Embedding, Reranker & NLI Models
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
NLI_MODEL_NAME=cross-encoder/nli-deberta-v3-small

# Degraded-mode-only fallback tool name, consulted only when the MCP server's live
# tool manifest is empty (see app/mcp/client.py, app/agents/planner.py)
DEFAULT_RETRIEVAL_TOOL_FALLBACK=search_documentation

# Local Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Ollama defaults num_ctx to 2048 regardless of the model's real context length
# (Qwen2.5:3b natively supports 32768). 8192 covers this pipeline's worst-case prompt
# (up to 10 merged evidence chunks + system prompt) with headroom for generation.
OLLAMA_NUM_CTX=8192

# Retrieval & RRF Pipeline Settings
RETRIEVAL_MODE=hybrid_rerank
TOP_K=5
HYBRID_TOP_K=20
RERANK_TOP_K=5
RRF_K=60

# Calibrated Chunking Configuration (conservative for bge-base-en-v1.5's 512-token limit)
CHUNK_SIZE=200
CHUNK_OVERLAP=30
MAX_CHUNK_SIZE=240

# LangGraph Agent Execution Budgets
MAX_AGENT_STEPS=6
MAX_LLM_CALLS=6
MAX_TOOL_CALLS=5
MAX_SUB_QUESTIONS=3
MAX_RETRIES=2
MEMORY_TURNS=5

# Security & API Keys
API_KEY=dev-api-key
MCP_API_KEY=mcp-secret-token

# Logging & Telemetry
LOG_LEVEL=INFO
